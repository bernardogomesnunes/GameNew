# Cloud sync. All three are public by design: the Data API URL and the Stack Auth
# publishable key are meant to ship in a browser bundle, and neither grants any
# access on its own — row-level security keyed on the signed-in user decides what
# each request can read. Delete these three lines and the game runs local-only.
#
# On Vercel, set the same three as Environment Variables so preview and
# production builds pick them up.
VITE_NEON_DATA_API_URL=https://ep-quiet-firefly-ae3s1zgl.apirest.c-2.us-east-2.aws.neon.tech/neondb/rest/v1
VITE_STACK_PROJECT_ID=b0dd0ce6-26a9-49b2-91b9-38b82ab00325
VITE_STACK_PUBLISHABLE_CLIENT_KEY=pck_w43jrhdth51zb36edg6evmfw8yvxefhg69vzwrtz8wtg0
